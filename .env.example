# Database (dev local)
DATABASE_URL="file:./dev.db"

# Produção Vercel + Turso (libsql://...)
# TURSO_AUTH_TOKEN=""

# Auth.js
AUTH_SECRET="gere-com-openssl-rand-base64-32"

# --- Opção A: localhost (HTTP) ---
# AUTH_URL="http://localhost:3000/api/auth"
# NEXTAUTH_URL="http://localhost:3000/api/auth"

# --- Opção B: ngrok (HTTPS) — recomendado se Spotify recusar HTTP ---
# Rode: ngrok http 3000  e cole a URL HTTPS abaixo (sem barra no final)
NGROK_URL="https://SEU-SUBDOMINIO.ngrok-free.app"
AUTH_URL="https://SEU-SUBDOMINIO.ngrok-free.app/api/auth"
NEXTAUTH_URL="https://SEU-SUBDOMINIO.ngrok-free.app/api/auth"

# Spotify Developer Dashboard → Redirect URIs:
# https://SEU-SUBDOMINIO.ngrok-free.app/api/auth/callback/spotify

SPOTIFY_CLIENT_ID=""
SPOTIFY_CLIENT_SECRET=""

# AudD - https://audd.io/
AUDD_API_TOKEN=""

# LLM do agente — OpenRouter (recomendado) https://openrouter.ai/keys
OPENROUTER_API_KEY=""
# Modelos :free válidos: meta-llama/llama-3.3-70b-instruct:free, openai/gpt-oss-20b:free
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"
# LLM_PROVIDER="openrouter"  # openrouter | gemini (opcional)

# Google Gemini (fallback) - https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"

CRON_SECRET="dev-cron-secret"
